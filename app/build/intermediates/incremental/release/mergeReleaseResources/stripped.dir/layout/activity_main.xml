<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Main Content Area -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Overlay View for Stage 1: Dimmed Screen -->
        <View
            android:id="@+id/dimOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:visibility="gone" />

        <!-- Overlay View for Stage 2: Off / Black Screen + Clock Screensaver -->
        <FrameLayout
            android:id="@+id/offOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF000000"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/clockContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvClockTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:01"
                    android:textColor="#FFFFFF"
                    android:textSize="130sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tvClockDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Martes, 8 De Septiembre"
                    android:textColor="#64B5F6"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Debug Overlay View -->
        <TextView
            android:id="@+id/tvDebugOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="#CC000000"
            android:textColor="#00FF00"
            android:textSize="12sp"
            android:padding="8dp"
            android:fontFamily="monospace"
            android:text="[Debug] X=0, Y=0"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Sidebar Settings Drawer -->
    <ScrollView
        android:id="@+id/settingsDrawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ajustes Kiosk"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="20dp" />

            <!-- URL Label & Input -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="URL de la página Web:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etUrl"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:inputType="textUri"
                android:text="https://pueblo.aferbel.es"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:background="#F0F4F8"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="16dp"
                android:importantForAutofill="no" />

            <!-- Dim Timeout Label & Input -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tiempo para oscurecer (segundos):"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etDimTime"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:inputType="number"
                android:text="10"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:background="#F0F4F8"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="16dp"
                android:importantForAutofill="no" />

            <!-- Off Timeout Label & Input -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tiempo para apagar todo (segundos):"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etOffTime"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:inputType="number"
                android:text="60"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:background="#F0F4F8"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginBottom="16dp"
                android:importantForAutofill="no" />

            <!-- Clock Size Controls -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tamaño del Reloj:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#F0F4F8"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnClockSizeMinus"
                    android:layout_width="50dp"
                    android:layout_height="40dp"
                    android:text="-"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:backgroundTint="#6200EE"
                    android:padding="0dp" />

                <TextView
                    android:id="@+id/tvClockSizeValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="130 sp"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnClockSizePlus"
                    android:layout_width="50dp"
                    android:layout_height="40dp"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:backgroundTint="#6200EE"
                    android:padding="0dp" />
            </LinearLayout>

            <!-- Clock Options Checkboxes -->
            <CheckBox
                android:id="@+id/cbShowClock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mostrar reloj al apagar pantalla"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:checked="true"
                android:layout_marginBottom="10dp" />

            <CheckBox
                android:id="@+id/cbDvdMove"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mover reloj cada minuto (protección)"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:checked="true"
                android:layout_marginBottom="10dp" />

            <!-- Debug Checkbox -->
            <CheckBox
                android:id="@+id/cbDebug"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Depuración (mostrar coordenadas X,Y)"
                android:textColor="#D32F2F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:checked="false"
                android:layout_marginBottom="24dp" />

            <!-- Save Button -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Guardar y Cargar Web"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#6200EE" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nota: Desliza desde el borde izquierdo para volver a abrir este menú en cualquier momento."
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="20dp" />

        </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
